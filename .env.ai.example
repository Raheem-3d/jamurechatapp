# ==========================================
# AI FEATURES - PERPLEXITY API
# ==========================================
# Add this to your existing .env file

# AI Provider: 'perplexity' or 'ollama'
AI_PROVIDER=perplexity

# Ollama settings (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Perplexity API Key (Required if using Perplexity)
# Get your key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Optional: Enable AI debug logging
AI_DEBUG=false
APP_URL=http://10.0.4.106:3000
# Optional: AI Feature Flags (enable/disable specific features)
ENABLE_AI_SUMMARIZATION=true
ENABLE_AI_SENTIMENT=true
ENABLE_AI_TASK_BREAKDOWN=true
ENABLE_AI_ASSISTANT=true
ENABLE_AI_SMART_REPLIES=true


# Database
DATABASE_URL="mysql://user:password@localhost:3306/database"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Perplexity AI (ADD THIS)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxx

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your@gmail.com
SMTP_PASS=app_password

# Razorpay (Optional)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# ==========================================
# EXISTING ENVIRONMENT VARIABLES
# (Keep your existing .env content below)
# ==========================================
