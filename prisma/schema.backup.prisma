generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model recordtags {
  A String
  B String

  @@unique([A, B], map: "_RecordTags_AB_unique")
  @@index([B], map: "_RecordTags_B_index")
  @@map("_recordtags")
}

model activitylog {
  id             String   @id
  organizationId String
  userId         String?
  action         String
  details        String?  @db.LongText
  reason         String?
  impersonation  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([action], map: "ActivityLog_action_idx")
  @@index([organizationId], map: "ActivityLog_organizationId_idx")
  @@index([userId], map: "ActivityLog_userId_idx")
}

model announcement {
  id             String   @id
  organizationId String?
  scope          String   @default("GLOBAL")
  title          String
  message        String   @db.Text
  createdAt      DateTime @default(now())
  published      Boolean  @default(true)

  @@index([organizationId], map: "Announcement_organizationId_idx")
  @@index([scope], map: "Announcement_scope_idx")
}

model announcementdismissal {
  id             String   @id
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  @@unique([announcementId, userId], map: "AnnouncementDismissal_announcementId_userId_key")
  @@index([userId], map: "AnnouncementDismissal_userId_idx")
}

model automationrule {
  id            String    @id
  name          String
  description   String?
  trigger       String?
  conditions    String    @db.LongText
  actions       String    @db.LongText
  enabled       Boolean   @default(true)
  applyToAll    Boolean   @default(false)
  stopOnFirst   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  lastTriggered DateTime?
  userId        String
  projectId     String
  taskId        String?
  stageId       String?

  @@index([projectId], map: "AutomationRule_projectId_idx")
  @@index([stageId], map: "AutomationRule_stageId_fkey")
  @@index([taskId], map: "AutomationRule_taskId_fkey")
  @@index([trigger], map: "AutomationRule_trigger_idx")
  @@index([userId], map: "AutomationRule_userId_idx")
}

model channel {
  id              String   @id
  name            String
  description     String?
  isPublic        Boolean  @default(true)
  isDepartment    Boolean  @default(false)
  isTaskThread    Boolean  @default(false)
  organizationId  String?
  taskId          String?  @unique(map: "Channel_taskId_key")
  taskReferenceId String?
  creatorId       String
  type            String?  @default("GENERAL")
  departmentId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([creatorId], map: "Channel_creatorId_fkey")
  @@index([departmentId], map: "Channel_departmentId_fkey")
  @@index([organizationId], map: "Channel_organizationId_fkey")
}

model channelmember {
  id        String   @id
  userId    String
  channelId String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([userId, channelId], map: "ChannelMember_userId_channelId_key")
  @@index([channelId], map: "ChannelMember_channelId_fkey")
}

model department {
  id        String   @id
  name      String   @unique(map: "Department_name_key")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model emaillog {
  id             String        @id
  userId         String
  organizationId String?
  type           emaillog_type
  subject        String
  to             String
  scheduledFor   DateTime?
  sentAt         DateTime?
  metadata       String?       @db.LongText
  createdAt      DateTime      @default(now())
  subscriptionId String?

  @@unique([userId, type, scheduledFor], map: "EmailLog_userId_type_scheduledFor_key")
  @@index([organizationId], map: "EmailLog_organizationId_fkey")
  @@index([subscriptionId], map: "EmailLog_subscriptionId_fkey")
  @@index([type], map: "EmailLog_type_idx")
  @@index([userId], map: "EmailLog_userId_idx")
}

model invitationtoken {
  id        String   @id
  token     String   @unique(map: "InvitationToken_token_key")
  email     String
  taskId    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email], map: "InvitationToken_email_idx")
  @@index([taskId], map: "InvitationToken_taskId_fkey")
  @@index([token], map: "InvitationToken_token_idx")
}

model message {
  id              String   @id
  content         String   @db.Text
  senderId        String
  receiverId      String?
  channelId       String?
  organizationId  String?
  isPinned        Boolean  @default(false)
  attachments     String?  @db.LongText
  fileUrl         String?
  fileName        String?
  fileType        String?
  seenBy          String?  @db.LongText
  reactions       String?  @db.LongText
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  pinnedMessageId String?
  isBuzz          Boolean  @default(false)

  @@index([channelId, createdAt], map: "Message_channelId_createdAt_idx")
  @@index([organizationId], map: "Message_organizationId_idx")
  @@index([pinnedMessageId], map: "Message_pinnedMessageId_fkey")
  @@index([receiverId, createdAt], map: "Message_receiverId_createdAt_idx")
  @@index([senderId, createdAt], map: "Message_senderId_createdAt_idx")
}

model notification {
  id             String            @id
  type           notification_type
  messageId      String?
  channelId      String?
  taskId         String?
  reminderId     String?
  announcementId String?
  organizationId String?
  content        String            @db.Text
  read           Boolean           @default(false)
  userId         String
  createdAt      DateTime          @default(now())

  @@index([announcementId], map: "Notification_announcementId_idx")
  @@index([organizationId], map: "Notification_organizationId_idx")
  @@index([taskId], map: "Notification_taskId_idx")
  @@index([userId, read, createdAt], map: "Notification_userId_read_createdAt_idx")
}

model organization {
  id             String                   @id
  name           String
  slug           String?                  @unique(map: "Organization_slug_key")
  industry       String?
  employeesCount Int?
  primaryEmail   String                   @unique(map: "Organization_primaryEmail_key")
  phone          String?
  address        String?
  logoUrl        String?
  themeColor     String?
  trialStart     DateTime
  trialEnd       DateTime
  trialStatus    organization_trialStatus @default(ACTIVE)
  suspended      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime
}

model orginvite {
  id             String         @id
  organizationId String
  email          String
  role           orginvite_role @default(EMPLOYEE)
  token          String         @unique(map: "OrgInvite_token_key")
  accepted       Boolean        @default(false)
  expires        DateTime
  createdAt      DateTime       @default(now())

  @@index([email], map: "OrgInvite_email_idx")
  @@index([organizationId], map: "OrgInvite_organizationId_idx")
  @@index([token], map: "OrgInvite_token_idx")
}

model payment {
  id             String         @id
  userId         String
  organizationId String?
  orderId        String         @unique(map: "Payment_orderId_key")
  paymentId      String?
  signature      String?
  amount         Int
  currency       String         @default("INR")
  status         payment_status @default(CREATED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  subscriptionId String?

  @@index([organizationId], map: "Payment_organizationId_fkey")
  @@index([status], map: "Payment_status_idx")
  @@index([subscriptionId], map: "Payment_subscriptionId_fkey")
  @@index([userId], map: "Payment_userId_idx")
}

model record {
  id           String    @id
  title        String
  description  String?
  dueDate      DateTime?
  startDate    DateTime?
  endDate      DateTime?
  createdBy    String
  priority     String
  status       String?
  parentTaskId String?
  stageId      String?
  isComplete   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([createdBy], map: "Record_createdBy_fkey")
  @@index([stageId], map: "Record_stageId_fkey")
}

model reminder {
  id          String            @id
  title       String
  description String?           @db.Text
  remindAt    DateTime
  isMuted     Boolean           @default(false)
  isSent      Boolean           @default(false)
  isAutomatic Boolean           @default(false)
  priority    reminder_priority @default(MEDIUM)
  type        reminder_type     @default(GENERAL)
  creatorId   String
  assigneeId  String
  taskId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime
  sentAt      DateTime?

  @@index([assigneeId], map: "Reminder_assigneeId_idx")
  @@index([creatorId], map: "Reminder_creatorId_idx")
  @@index([remindAt, isSent, isMuted], map: "Reminder_remindAt_isSent_isMuted_idx")
  @@index([taskId], map: "Reminder_taskId_idx")
}

model session {
  id           String   @id
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime

  @@index([userId], map: "Session_userId_fkey")
}

model stage {
  id           String   @id
  name         String
  taskId       String
  color        String
  assignedTeam String?
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([taskId], map: "Stage_taskId_fkey")
}

model subscription {
  id               String              @id
  organizationId   String              @unique(map: "Subscription_organizationId_key")
  status           subscription_status @default(TRIAL)
  trialStart       DateTime
  trialEnd         DateTime
  trialUsed        Boolean             @default(true)
  currentPeriodEnd DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
}

model tag {
  id   String @id
  name String
}

model task {
  id             String        @id
  title          String
  description    String?       @db.Text
  priority       task_priority @default(MEDIUM)
  status         task_status   @default(TODO)
  deadline       DateTime?
  organizationId String?
  creatorId      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  deadlineEnd    DateTime?
  deadlineStart  DateTime?

  @@index([creatorId], map: "Task_creatorId_idx")
  @@index([organizationId, status, deadline], map: "Task_organizationId_status_deadline_idx")
  @@index([status, priority], map: "Task_status_priority_idx")
}

model taskactivity {
  id          String   @id
  taskId      String
  userId      String
  type        String
  description String
  timestamp   DateTime @default(now())
  tag         String?
  recordId    String?

  @@index([recordId], map: "TaskActivity_recordId_fkey")
  @@index([taskId], map: "TaskActivity_taskId_idx")
  @@index([type], map: "TaskActivity_type_idx")
  @@index([userId], map: "TaskActivity_userId_idx")
}

model taskassignment {
  id        String   @id
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  recordId  String?

  @@unique([taskId, userId, recordId], map: "TaskAssignment_taskId_userId_recordId_key")
  @@index([recordId], map: "TaskAssignment_recordId_fkey")
  @@index([userId], map: "TaskAssignment_userId_fkey")
}

model taskclient {
  id          String   @id
  taskId      String
  userId      String
  role        String   @default("CLIENT")
  accessLevel String   @default("VIEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@unique([taskId, userId], map: "TaskClient_taskId_userId_key")
  @@index([userId], map: "TaskClient_userId_fkey")
}

model taskcomment {
  id        String   @id
  content   String   @db.Text
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([taskId], map: "TaskComment_taskId_fkey")
  @@index([userId], map: "TaskComment_userId_fkey")
}

model taskinvitation {
  id          String   @id
  taskId      String
  email       String
  role        String   @default("CLIENT")
  accessLevel String   @default("VIEW")
  invitedById String
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@unique([taskId, email], map: "TaskInvitation_taskId_email_key")
  @@index([invitedById], map: "TaskInvitation_invitedById_fkey")
}

model user {
  id             String    @id
  name           String?
  email          String    @unique(map: "User_email_key")
  emailVerified  DateTime?
  image          String?
  password       String?
  role           user_role @default(EMPLOYEE)
  isSuperAdmin   Boolean   @default(false)
  organizationId String?
  departmentId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  subscriptionId String?
  permissions    String?   @db.LongText
  managerId      String?

  @@index([departmentId], map: "User_departmentId_fkey")
  @@index([email], map: "User_email_idx")
  @@index([managerId], map: "User_managerId_fkey")
  @@index([organizationId, role], map: "User_organizationId_role_idx")
  @@index([subscriptionId], map: "User_subscriptionId_fkey")
}

enum notification_type {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENT
  CHANNEL_INVITE
  DIRECT_MESSAGE
  CHANNEL_MESSAGE
  REMINDER
  ANNOUNCEMENT
}

enum subscription_status {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum emaillog_type {
  TRIAL_REMINDER
  TRIAL_EXPIRED
  PAYMENT_RECEIPT
}

enum orginvite_role {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  EMPLOYEE
  ORG_MEMBER
  CLIENT
}

enum task_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum task_status {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum user_role {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  EMPLOYEE
  ORG_MEMBER
  CLIENT
}

enum reminder_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum payment_status {
  CREATED
  PAID
  FAILED
}

enum reminder_type {
  GENERAL
  TASK_DEADLINE
  MEETING
  FOLLOW_UP
  PERSONAL
}

enum organization_trialStatus {
  ACTIVE
  EXPIRED
}
