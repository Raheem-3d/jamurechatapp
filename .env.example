# DATABASE_URL="mysql://root:@localhost:3306/chatApp"
# Pusher (for real-time features)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
APP_URL=http://localhost:3000

# Redis Connection (Optional: For multi-node Socket.io scaling & caching)
REDIS_URL="redis://127.0.0.1:6379"

# Kafka Connection (Optional: For background event streaming & audit logging)
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="jamurechat-app"


# AI Provider: 'perplexity' or 'ollama'
AI_PROVIDER=perplexity

# Ollama settings (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b

PERPLEXITY_API_KEY=pplx-your-key-here

# Optional: Enable AI debug logging
AI_DEBUG=false

# Optional: AI Feature Flags (enable/disable specific features)
ENABLE_AI_SUMMARIZATION=true
ENABLE_AI_SENTIMENT=true
ENABLE_AI_TASK_BREAKDOWN=true
ENABLE_AI_ASSISTANT=true
ENABLE_AI_SMART_REPLIES=true

